{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ds-skills.local/schemas/storybook-component-spec.schema.json",
  "title": "Storybook Component Spec",
  "description": "One file per component: the design<->code contract and the story kinds the component owes. Portable, with two declared repo-profile extension points \u2014 see x-repo-profile on tier and generatedArtifactRefs.",
  "type": "object",
  "required": [
    "specVersion",
    "componentId",
    "tier",
    "requiredStoryKinds",
    "ownedStoryRefs",
    "generatedArtifactRefs",
    "downstreamHooks"
  ],
  "additionalProperties": false,
  "properties": {
    "specVersion": {
      "const": "1",
      "description": "Literal. Bump only alongside a validator change."
    },
    "componentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "kebab-case. Must equal the spec filename stem \u2014 a filesystem rule JSON Schema cannot express, enforced by the validator."
    },
    "tier": {
      "type": "string",
      "minLength": 1,
      "x-repo-profile": "tier-policy",
      "description": "REPO PROFILE. Deliberately an open string here: allowed values and their minimum required kinds are owned by the repo's tier policy (see storybook-tier-policy.schema.json), not by this spec."
    },
    "requiredStoryKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/storyKind"
      },
      "description": "Kinds this component must prove. Must be a superset of the tier policy's minimumRequiredKinds for this tier."
    },
    "ownedStoryRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ownedStoryRef"
      },
      "description": "Stories this spec owns. storyId must be unique across the array."
    },
    "generatedArtifactRefs": {
      "$ref": "#/$defs/generatedArtifactRefs"
    },
    "downstreamHooks": {
      "$ref": "#/$defs/downstreamHooks"
    }
  },
  "$defs": {
    "storyKind": {
      "type": "string",
      "enum": [
        "default",
        "variant-matrix",
        "state-matrix",
        "actions",
        "controlled",
        "keyboard",
        "focus",
        "workflow",
        "motion",
        "async",
        "docs",
        "responsive",
        "composition"
      ]
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.\\.?/)(?!.*://).+$",
      "description": "Repo-relative path. Not absolute, not ./ or ../ prefixed, no URI scheme."
    },
    "nullableRepoPath": {
      "oneOf": [
        {
          "$ref": "#/$defs/repoPath"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableString": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "ownedStoryRef": {
      "type": "object",
      "required": ["storyId", "kinds"],
      "additionalProperties": false,
      "properties": {
        "storyId": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/storyKind"
          }
        }
      }
    },
    "generatedArtifactRefs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/nullableRepoPath"
      },
      "description": "Named generated proof surfaces. The project proof configuration supplies the required key set; values remain nullable relative paths."
    },
    "downstreamHooks": {
      "type": "object",
      "description": "Durable code and design references. These links alone do not prove implementation or publication.",
      "required": [
        "codeEntrypoint",
        "figmaComponentRef",
        "supportedVariantsSource",
        "slotNamesSource",
        "exampleStoryIds"
      ],
      "additionalProperties": false,
      "properties": {
        "codeEntrypoint": {
          "$ref": "#/$defs/nullableString"
        },
        "figmaComponentRef": {
          "$ref": "#/$defs/nullableString"
        },
        "supportedVariantsSource": {
          "$ref": "#/$defs/nullableString"
        },
        "slotNamesSource": {
          "$ref": "#/$defs/nullableString"
        },
        "exampleStoryIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
