{
  "name": "@atomize-hq/ds-skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atomize-hq/ds-skills.git"
  },
  "homepage": "https://github.com/atomize-hq/ds-skills#readme",
  "bugs": "https://github.com/atomize-hq/ds-skills/issues",
  "version": "0.3.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ds-skills": "bin/ds-skills.mjs"
  },
  "description": "Publish a DTCG token artifact into Figma variables, and check a Figma file for drift against it. Repo is canonical; Figma is downstream.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin/*": "./plugin/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "plugin",
    "README.md"
  ],
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:plugin": "node plugin/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm smoke && pnpm pack-check",
    "prepare": "pnpm build",
    "smoke": "node --input-type=module -e \"import('./dist/index.js').then(m=>{if(typeof m.flattenTokenDocument!=='function'||typeof m.buildExpectedVariables!=='function')throw new Error('built package does not expose its API');console.log('smoke ok')})\"",
    "pack-check": "bash scripts/pack-check.sh"
  },
  "peerDependencies": {
    "esbuild": ">=0.20.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.112.0",
    "@types/node": "^25.5.0",
    "esbuild": "^0.25.9",
    "prettier": "3.8.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.0"
  }
}
