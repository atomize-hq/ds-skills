{
  "policyVersion": "1.0.0",
  "baselineDate": "2026-01-01",
  "framework": "@storybook/nextjs-vite",
  "storybookVersion": "10.2.19",
  "requiredAddons": [
    "@storybook/addon-vitest",
    "@storybook/addon-a11y",
    "@storybook/addon-designs",
    "@chromatic-com/storybook"
  ],
  "requiredImports": {
    "test": "storybook/test",
    "previewApi": "storybook/preview-api",
    "actions": "storybook/actions"
  },
  "disallowedLegacyPackages": [
    "@storybook/addon-interactions",
    "@storybook/experimental-addon-test",
    "@storybook/test-runner",
    "@storybook/test"
  ],
  "configFiles": [".storybook/main.ts", ".storybook/preview.ts"],
  "validationCommands": [
    "node .agents/skills/scripts/validate-artifact.mjs .agents/skills/schemas/storybook-version-policy.schema.json .storybook/storybook-version-policy.json",
    "node .agents/skills/scripts/validate-artifact.mjs .agents/skills/schemas/storybook-tier-policy.schema.json storybook/component-tier-policy.json",
    "node .agents/skills/scripts/validate-artifact.mjs .agents/skills/schemas/storybook-story-inventory.schema.json storybook/story-inventory.json"
  ],
  "notes": [
    "Keep all Storybook packages on the same exact release line.",
    "Review and intentionally update this file on every Storybook upgrade.",
    "validationCommands starts on the skill pack's generic validator because that is what a repo has on day one. Once the repo owns semantic validators with cross-field and referential checks, replace these entries with those commands — the pack validator only checks shape."
  ]
}
